<%#
  搜索结果页 /search/
  ===========================================================================
  页面骨架在服务端渲染，结果列表由 /js/search-page.js 从 /search.json 拉索引
  后在浏览器里算。不预渲染任何结果：搜索词来自 URL，构建期不知道。

  索引结构与体积见 scripts/search-index.js 的文件头注释。
%>
<div class="search-page">

  <header class="search-head">
    <h1 class="page-heading"><%= tr('search_page.title') %></h1>
    <p class="search-intro"><%= tr('search_page.intro') %></p>
  </header>

  <div class="search-box">
    <span class="search-box__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
    </span>
    <input
      type="search"
      id="searchPageInput"
      class="search-box__input"
      placeholder="<%= tr('search_page.placeholder') %>"
      aria-label="<%= tr('search_page.placeholder') %>"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="search"
    >
    <button type="button" class="search-box__clear" id="searchPageClear"
            aria-label="<%= tr('search_page.clear') %>" hidden>✕</button>
  </div>

  <p class="search-status" id="searchStatus" role="status" aria-live="polite"></p>

  <ol class="search-results" id="searchResults"></ol>

  <div class="search-empty" id="searchEmpty" hidden>
    <p class="search-empty__title"><%= tr('search_page.empty_title') %></p>
    <p class="search-empty__hint"><%= tr('search_page.empty_hint') %></p>
  </div>

</div>

<script src="<%= url_for('/js/search-page.js') %>" defer></script>
