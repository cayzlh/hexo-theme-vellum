<%
  /* ==========================================================================
     文章目录（桌面侧栏 + 移动端底部面板）
     --------------------------------------------------------------------------
     这个 partial 只做渲染，交互全在 /js/toc.js 里 —— 以前是内联 <script>，
     153 个页面各背一份 4KB、无法缓存，档案页还复制了第二份（两份已经漂移
     出行为差异）。现在两个页面共用同一个外部脚本，模板只输出 data- 配置。

     三块输出里，.toc（桌面侧栏）和 .toc-panel（移动面板）保留；
     原来的 .toc-mobile 内联折叠块已删除 —— 它只在 769~1023px 这段可见，
     平板上已经有底部面板可用，两套并存反而多一份用不上的 DOM。
     ========================================================================== */

  function renderToc(items) {
    var html = '';
    for (var i = 0; i < items.length; i++) {
      var item = items[i];
      var hasChildren = !!(item.children && item.children.length > 0);
      html += '<li class="toc-item toc-level-' + item.level
        + (hasChildren ? ' has-children' : '') + '">';
      html += '<a href="#' + item.id + '" class="toc-link" data-toc="' + item.id + '">'
        + item.text + '</a>';
      if (hasChildren) {
        html += '<ul class="toc-list">' + renderToc(item.children) + '</ul>';
      }
      html += '</li>';
    }
    return html;
  }

  var tocCfg = theme.toc || {};
  var tocW = tocCfg.width || '';
  var tocPos = tocCfg.position || 'right';
  var tocHtml = renderToc(page.toc);
%>

<!-- 桌面侧栏目录（≤1023px 隐藏，由底部面板接管） -->
<div class="toc<%= tocPos === 'left' ? ' toc-left' : '' %>"<% if (tocW) { %> style="--toc-w:<%= tocW %>"<% } %>
     data-toc-highlight="<%= tocCfg.highlight_on_scroll !== false %>"
     data-toc-collapse="<%= tocCfg.auto_collapse !== false %>">
  <div class="toc-fixed">
    <div class="toc-wrapper<%= tocCfg.show_tree_line === false ? ' toc-no-tree-line' : '' %>">
      <div class="toc-title"><%= tr('toc.title') %></div>
      <ul class="toc-list"><%- tocHtml %></ul>
      <% if (tocCfg.show_back_to_top !== false) { %>
      <div class="toc-footer">
        <button class="toc-back-top" type="button">
          <span class="toc-back-icon">↑</span> <%= tr_cfg(tocCfg.back_to_top_text, 'common.back_to_top') %>
        </button>
      </div>
      <% } %>
    </div>
  </div>
</div>
