<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content="Hexo">

  <!-- Title -->
  <title><%- seo_title(page) %></title>

  <!-- Robots -->
  <%#
    这里原来有一段完全没用的分支：两半都输出同一个 <meta name="robots">，
    中间还留了个没被读过的 `backupEnv` 变量。删掉分支，只保留真正的规则：

    默认不输出 robots 标签（抓取/索引由 robots.txt 与 canonical 管）；
    页面自己在 front-matter 写了 robots 才输出，让作者能逐个页面表态。
    首页也照此处理——旧实现把首页排除在外，导致首页想屏蔽时无从下手。
  %>
  <% if (page.robots) { %><meta name="robots" content="<%= page.robots %>"><% } %>
  <% if (page.sitemap === false && !page.robots) { %><meta name="robots" content="noindex, follow"><% } %>

  <!-- Description -->
  <% var seoDesc = seo_description(page); %>
  <% if (seoDesc) { %><meta name="description" content="<%= safe_meta(seoDesc) %>"><% } %>

  <!-- Keywords -->
  <% var seoKw = seo_keywords(page); %>
  <% if (seoKw) { %><meta name="keywords" content="<%= seoKw %>"><% } %>

  <!-- Canonical -->
  <%
  /* og:url 与 canonical 必须是同一个地址。
     旧实现里 og:url 是 `config.url + '/' + page.path`，也就是
     https://www.cayzlh.com/index.html、https://…/post/xxx/index.html/garbage
     这种「带文件名」的形态；而 canonical 已经规整成干净的目录形态。
     两个地址不一致时，社交平台抓到的分享链接会落到一个 307 上，
     部分抓取器直接放弃取图。这里统一用 canonical_url() 的结果。 */
  var canonUrl = canonical_url(page);
  if (canonUrl) { %><link rel="canonical" href="<%= canonUrl %>"><% } %>

  <!-- Open Graph -->
  <% if (theme.open_graph && theme.open_graph.enable) {
    /* og:title 跟 <title> 保持一致：两处不一致会在分享卡片上显示成
       两个不同的标题，读者会以为是两篇文章。 */
    var ogTitle = seo_title(page);
    var ogDesc = seoDesc || config.description;
    var ogUrl = canonUrl || (config.url + '/' + (page.path || ''));
    /* og:image 必须是绝对 URL：Facebook/微信/Telegram 都不解析相对路径。
       本站 avatar 与部分 cover 写的是 /avatar.svg 这类站内路径。 */
    function ogAbs(u) {
      if (!u) return '';
      if (/^https?:\/\//i.test(u)) return u;
      return (config.url || '').replace(/\/+$/, '') + (u.charAt(0) === '/' ? u : '/' + u);
    }
    var ogImage = ogAbs(page.og_image || page.cover || page.banner || (theme.open_graph.default_image) || config.avatar);
    var ogType = page.layout === 'post' ? 'article' : 'website';
  %>
    <meta property="og:title" content="<%= safe_meta(ogTitle) %>">
    <meta property="og:description" content="<%= safe_meta(ogDesc) %>">
    <meta property="og:url" content="<%= ogUrl %>">
    <meta property="og:type" content="<%= ogType %>">
    <meta property="og:site_name" content="<%= config.title %>">
    <% if (page.layout === 'post' && page.date) { %>
    <meta property="article:published_time" content="<%= date_xml(page.date) %>">
    <meta property="article:modified_time" content="<%= date_xml(page.updated || page.date) %>">
    <% if (config.author) { %><meta property="article:author" content="<%= config.author %>"><% } %>
    <% } %>
    <% if (ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
    <!-- Twitter Card -->
    <%
    /* summary_large_image 要求有图。没有可用图时降级成 summary，
       否则 Twitter 会退回一张灰色占位卡，比不放大图更难看。 */
    var twCard = theme.open_graph.twitter_card || 'summary_large_image';
    if (twCard === 'summary_large_image' && !ogImage) twCard = 'summary';
    %>
    <meta name="twitter:card" content="<%= twCard %>">
    <% if (theme.open_graph.twitter_id) { %><meta name="twitter:site" content="@<%= theme.open_graph.twitter_id %>"><% } %>
    <% if (theme.open_graph.twitter_id) { %><meta name="twitter:creator" content="@<%= theme.open_graph.twitter_id %>"><% } %>
    <meta name="twitter:title" content="<%= safe_meta(ogTitle) %>">
    <meta name="twitter:description" content="<%= safe_meta(ogDesc) %>">
    <% if (ogImage) { %><meta name="twitter:image" content="<%= ogImage %>"><% } %>
  <% } %>

  <!-- Structured Data (JSON-LD) -->
  <% var ld = json_ld(page, config); %>
  <% if (ld) { %><script type="application/ld+json"><%- ld %></script><% } %>

  <!-- Feed -->
  <% if (config.feed && config.feed.path) { %>
    <link rel="alternate" href="<%= url_for(config.feed.path) %>" type="application/atom+xml" title="<%= config.title %>">
  <% } %>

  <!-- Fonts are self-hosted (Maple Mono NF CN by The Maple Mono Project Authors,
       https://github.com/subframe7536/maple-font, SIL OFL-1.1 — a third-party
       typeface we subset, not our own work) — no third-party origin
       is on the critical path any more. Preload only the two chunks that the
       first screen needs; the BMP ideograph chunk is fetched on demand via
       unicode-range and falls back with font-display: swap. -->
  <link rel="preload" href="<%= url_for('/fonts/maple-latin-regular.woff2') %>" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="<%= url_for('/fonts/maple-latin-bold.woff2') %>" as="font" type="font/woff2" crossorigin>

  <!-- Stylesheet — fonts.css is a plain <link> rather than an @import so the
       @font-face rules are discovered in the same pass as the rest of the CSS. -->
  <link rel="stylesheet" href="<%= url_for('/css/fonts.css') %>">
  <link rel="stylesheet" href="<%= url_for('/css/tokens.css') %>">
  <link rel="stylesheet" href="<%= url_for('/css/style.css') %>">
  <link rel="stylesheet" href="<%= url_for('/css/appearance.css') %>">
  <% if (theme.mobile && theme.mobile.enable !== false) { %>
  <link rel="stylesheet" href="<%= url_for('/css/mobile.css') %>">
  <% } %>

  <%
  /* ==========================================================
     配置 → CSS 变量 桥接
     ----------------------------------------------------------
     tokens.css 定义的是**默认值**，它不读 YAML。这里把 _config.yml 里
     的 color / dark / link / 排版字段投影成 :root 上的自定义属性覆盖，
     让「改 YAML 就能换配色」这句话真的成立，而不是让读者去手改 CSS。

     只输出**显式配置过**的字段：没写的键保持 tokens.css 的原值，
     所以清空这几段配置就等于回到主题默认观感。
     ========================================================== */
  function cssVars(map) {
    var out = [];
    for (var k in map) {
      var v = map[k];
      if (v === undefined || v === null || v === '') continue;
      out.push(k + ':' + v);
    }
    return out.join(';');
  }
  var lightMap = {
    '--c-text': theme.color && (theme.color.text),
    '--c-text-light': theme.color && (theme.color['text-light']),
    '--c-text-muted': theme.color && (theme.color['text-muted']),
    '--c-bg': theme.color && (theme.color.background),
    '--c-bg-secondary': theme.color && (theme.color['background-secondary']),
    '--c-bg-tertiary': theme.color && (theme.color['background-tertiary']),
    '--c-link': (theme.link && theme.link.color) || (theme.color && theme.color.link),
    '--c-link-hover': (theme.link && theme.link.hover_color) || (theme.color && theme.color['link-hover']),
    '--c-accent': theme.color && (theme.color.accent),
    /* 改了 accent 之后填充块上的字色可能要跟着换，所以留了配置口子。
       不配就沿用 tokens.css 里按默认 accent 算好的值。 */
    '--c-on-accent': theme.color && (theme.color['on-accent']),
    '--c-border': theme.color && (theme.color.border),
    '--c-border-strong': theme.color && (theme.color['border-dark']),
    '--c-code-bg': theme.color && (theme.color['code-bg']),
    '--c-code-border': theme.color && (theme.color['code-border']),
    '--c-sel': theme.color && (theme.color.selection),
    '--fs': theme.font_size,
    '--lh': theme.line_height,
    '--mw': theme.max_width
  };
  var darkMap = {
    '--c-text': theme.dark && (theme.dark.text),
    '--c-text-light': theme.dark && (theme.dark['text-light']),
    '--c-text-muted': theme.dark && (theme.dark['text-muted']),
    '--c-bg': theme.dark && (theme.dark.background),
    '--c-bg-secondary': theme.dark && (theme.dark['background-secondary']),
    '--c-bg-tertiary': theme.dark && (theme.dark['background-tertiary']),
    '--c-link': theme.dark && (theme.dark.link),
    '--c-link-hover': theme.dark && (theme.dark['link-hover']),
    '--c-accent': theme.dark && (theme.dark.accent),
    '--c-on-accent': theme.dark && (theme.dark['on-accent']),
    '--c-border': theme.dark && (theme.dark.border),
    '--c-code-bg': theme.dark && (theme.dark['code-bg']),
    '--c-hover-bg': theme.dark && (theme.dark['hover-bg']),
    '--c-sel': theme.dark && (theme.dark.selection)
  };
  var rootVars = cssVars(lightMap);
  var darkVars = cssVars(darkMap);
  %>
  <% if (rootVars) { %>
  <style>:root{<%= rootVars %>}</style>
  <% } %>
  <% if (darkVars) { %>
  <style>html.dark{<%= darkVars %>}</style>
  <% } %>

  <!-- Favicon (theme.favicon > config.avatar > /favicon.ico) -->
  <link rel="icon" href="<%= theme.favicon || url_for(config.avatar || '/favicon.ico') %>">

  <!-- Custom head inject -->
  <% if (config.inject && config.inject.head) { %><%- config.inject.head.join('\n') %><% } %>
  <% if (theme.inject && theme.inject.head) { %><%- theme.inject.head.join('\n') %><% } %>

  <!-- Clone detection & utilities -->
  <script>
    window.__VELLUM = window.__VELLUM || {};
    <%# 界面文案词典：前端脚本（复制按钮、归档搜索、资讯页重渲染…）统一从这里取词。
        服务端已把回落做完（本语言缺的键由 zh-CN 补），前端不必再判语言。
        词典必须在 main.js 之前就位，所以跟着 head 的内联脚本走。 %>
    window.__VELLUM_I18N = <%- tr_dict() %>;
    window.tr = function (key) {
      var args = Array.prototype.slice.call(arguments, 1);
      var str = window.__VELLUM_I18N[key];
      if (str == null) return '';
      var i = 0;
      return String(str).replace(/%(s|d|%)/g, function (m, kind) {
        if (kind === '%') return '%';
        if (i >= args.length) return m;
        var v = args[i++];
        return String(v == null ? '' : v);
      });
    };
    <% if (theme.canonical && theme.canonical.originalHost) { %>
    window.__VELLUM.originalHost = '<%= theme.canonical.originalHost %>';
    window.__VELLUM.officialHosts = <%- JSON.stringify(theme.canonical.officialHosts || []) %>;
    <% } %>
  </script>
  <script src="<%= url_for('/js/main.js') %>" defer></script>
  <% if (theme.transition && theme.transition.enable !== false) { %>
  <script src="<%= url_for('/js/transition.js') %>" defer></script>
  <% } %>
</head>
