<%
// Homepage: Intro + Recent Posts + Random Posts

function fmtDate(d) {
  var dt = new Date(d);
  var y = dt.getFullYear();
  var m = ('0' + (dt.getMonth() + 1)).slice(-2);
  var day = ('0' + dt.getDate()).slice(-2);
  return y + '-' + m + '-' + day;
}

var introLines = (theme.intro || '').split('\n').filter(function(l){ return l.trim() !== '' });

// Recent 5 posts
var recentCount = theme.recent_posts_count || 5;
var allPosts = site.posts.sort('date', -1).toArray();
var recentPosts = allPosts.slice(0, recentCount);
/* 「近日所思」右下角「查看文章」的去处，默认指归档页——那里是全部文章。
   配成 '' 或 false 则不显示这个入口。 */
var recentMoreUrl = theme.recent_more_url === undefined ? '/archives/' : theme.recent_more_url;

// Random posts (exclude the recent ones)
/* random_posts_count 的三种语义要分开：
     undefined / null / ''  → 没配，用默认 5
     0 / false              → 明确关掉这一块（含标题），不是回退到 5
     正数                    → 取这么多条
   所以不能写成 `theme.random_posts_count || 5`——那个写法会把 0 和 false
   一起吞成 5，"关掉" 这个能力就不存在了。 */
var randomRaw = theme.random_posts_count;
var randomCount =
  randomRaw === undefined || randomRaw === null || randomRaw === ''
    ? 5
    : Number(randomRaw) > 0
      ? Number(randomRaw)
      : 0;
var pool = allPosts.slice(recentCount);
// Fisher-Yates shuffle
for (var i = pool.length - 1; i > 0; i--) {
  var j = Math.floor(Math.random() * (i + 1));
  var tmp = pool[i]; pool[i] = pool[j]; pool[j] = tmp;
}
var randomPosts = randomCount > 0 ? pool.slice(0, randomCount) : [];

/* ==========================================================================
   每日壁纸 banner（窄幅）
   --------------------------------------------------------------------------
   数据由 scripts/banner.js 在构建期抓好、挂在 theme.banner_today 上，
   这里只负责画。**不要改成前端 fetch**：首页是 4 小时一次的静态产物，
   让每个访客各自请求一次接口，等于把一次构建的代价换成每个首屏的代价。

   兜底是这个模块的第一需求：banner_today 为 null（接口挂了、图不可用、
   缓存过期又抓失败）时**整块不渲染**。首页不能出现一块灰底或一张裂图——
   这块内容本来就只是锦上添花，没有它首页依然完整。
   ========================================================================== */
var bannerCfg = theme.banner || {};
var banner = theme.banner_today || null;
/* 配置关掉时生成器根本不会填 banner_today，这里再判一次 enable：
   站点把 banner.enable 改成 false 后，即使某次构建残留了旧数据也不显示。 */
var showBanner = bannerCfg.enable !== false && !!banner;
var bannerPos = (banner && banner.position) || 'top';
%>

<% if (showBanner && bannerPos === 'top') { %>
<%- partial('_partial/banner') %>
<% } %>

<!-- Intro -->
<div class="intro">
  <% introLines.forEach(function(line) { %>
    <%- markdown(line) %>
  <% }); %>
  <%- partial('_partial/runtime_intro') %>
</div>

<hr class="<%= (theme.hr && theme.hr.home_style) ? 'style-' + theme.hr.home_style : 'home-hr' %>">

<% if (showBanner && bannerPos === 'after-intro') { %>
<%- partial('_partial/banner') %>
<% } %>

<!-- Recent Posts -->
<h2 class="section-title"><%= tr_cfg(theme.recent_posts_title, 'home.recent_posts') %></h2>
<ul class="post-list">
  <% recentPosts.forEach(function(post) { %>
    <li>
      <a href="<%= url_for(post.path) %>">
        <time class="post-list-date" datetime="<%= date_xml(post.date) %>">
          <%= fmtDate(post.date) %>
        </time>
         <span class="post-list-title"><%= post.title %></span>
      </a>
    </li>
  <% }); %>
</ul>
<% if (recentMoreUrl) { %>
  <div class="list-more">
    <a href="<%= url_for(recentMoreUrl) %>"><%= tr('home.recent_more') %></a>
  </div>
<% } %>

<% if (randomPosts.length > 0) { %>
  <h2 class="section-title"><%= tr_cfg(theme.random_posts_title, 'home.random_posts') %></h2>
  <ul class="post-list">
    <% randomPosts.forEach(function(post) { %>
      <li>
        <a href="<%= url_for(post.path) %>">
          <time class="post-list-date" datetime="<%= date_xml(post.date) %>">
            <%= fmtDate(post.date) %>
          </time>
           <span class="post-list-title"><%= post.title %></span>
        </a>
      </li>
    <% }); %>
  </ul>
<% } %>

<%
/* ==========================================================================
   逛逛博客 — 首页底部的「别人最近写了什么」
   --------------------------------------------------------------------------
   数据来自构建期抓的订阅源，与 /subscriptions/ 同一份结果（订阅生成器
   已经把摘要挂到 theme.config.subscriptions_latest）。

   ★ 兜底是这个模块的第一需求，不是可有可无的补充：
     站点没配任何订阅源、或者这次构建一个源都没抓到时，整个模块（含标题）
     都不渲染。首页绝不能出现「逛逛博客」下面空空如也的样子。

   判断依据只有一条：这次构建到底有没有拿到带链接的条目。
   「配没配订阅」不单独判断——配了但全抓失败（网络问题、源失效）时，
   结果同样是没内容，两种情况下都该整块消失。
   ========================================================================== */
var blogCfg = theme.subscriptions || {};
var blogShow = blogCfg.home_enable !== false;   /* 默认开启，显式 false 才关 */
var blogCount = blogCfg.home_count || 3;
var blogTitle = tr_cfg(blogCfg.home_title, 'home.visiting');
/* 「查看更多」的去处。默认指订阅页——首页这一块本来就是它的摘要，
   整份列表（全部源 + 按时间倒序的文章流）在那里。
   配成空串或 false 可以不显示这个入口。 */
var blogMoreUrl = blogCfg.home_more_url === undefined ? '/subscriptions/' : blogCfg.home_more_url;

var latest = (theme.subscriptions_latest && theme.subscriptions_latest.items) || [];
/* 只留真正能点的条目：没链接的抓进来也点不动，不如不显示。 */
var usable = latest.filter(function (it) {
  return it && it.title && it.link;
});

/* 按来源交错取，而不是纯按时间取前 N 条。
   原因很实际：聚合型订阅源（比如「十年之约」每天推多条）一次就能占满
   前三条，「逛逛博客」就会变成「逛逛某一个博客」，与这个模块的意图相反。
   这里做一次 round-robin：第一轮每源拿一条、第二轮再各拿一条……
   源够多时天然就是「三条来自三个博客」；源不够时才允许同源重复。 */
var bySource = [];
var bucket = Object.create(null);
usable.forEach(function (it) {
  var key = it.sourceName || it.sourceHomepage || '?';
  if (!bucket[key]) { bucket[key] = []; bySource.push(key); }
  bucket[key].push(it);
});

var blogPosts = [];
var round = 0;
while (blogPosts.length < blogCount && round < 20) {
  var added = false;
  for (var bi = 0; bi < bySource.length && blogPosts.length < blogCount; bi++) {
    var list = bucket[bySource[bi]];
    if (list.length > round) {
      blogPosts.push(list[round]);
      added = true;
    }
  }
  /* 一轮下来一个都没加 → 所有源都取空了，结束，避免死循环。 */
  if (!added) break;
  round++;
}
%>

<% if (blogShow && blogPosts.length > 0) { %>
  <h2 class="section-title"><%= blogTitle %></h2>
  <ul class="blog-visits">
    <% blogPosts.forEach(function (it) { %>
      <li>
        <%# 日期、标题、来源是 li 的三个平级子元素，按行内顺序自然接续
            （日期 → 标题 → 来源），标题长时来源跟着折行。不要把日期和标题
            一起包进 <a>：那样这三段就只剩一个行内盒子，来源无法跟在
            标题后面单独定位。标题自己仍然是链接，链接只包住可点的文字。 %>
        <time class="blog-visits-date" datetime="<%= it.pubDate || '' %>">
          <%= it.pubDate ? fmtDate(it.pubDate) : '' %>
        </time>
        <a class="blog-visits-title" href="<%= it.link %>" target="_blank" rel="noopener"><%= it.title %></a>
        <% if (it.sourceName) { %>
          <span class="blog-visits-source">
            <% if (it.sourceIcon) { %><span class="blog-visits-icon" aria-hidden="true"><%= it.sourceIcon %></span><% } %>
            <% if (it.sourceHomepage) { %>
              <a href="<%= it.sourceHomepage %>" target="_blank" rel="noopener"><%= it.sourceName %></a>
            <% } else { %>
              <%= it.sourceName %>
            <% } %>
          </span>
        <% } %>
      </li>
    <% }); %>
  </ul>
  <% if (blogMoreUrl) { %>
    <%# 入口放在列表右下方：与列表同宽的一行，链接靠右。
        不塞进最后一个 <li>，否则它会被 li 的 margin-bottom 一起带走。
        与「近日所思」的入口共用 .list-more 样式。 %>
    <div class="list-more">
      <a href="<%= url_for(blogMoreUrl) %>"><%= tr('home.visiting_more') %></a>
    </div>
  <% } %>
<% } %>
