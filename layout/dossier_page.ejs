<% var isHome = (page.type === 'project_home');
var bodyHtml = page.content_html || render_md(page.content);
%>

<!-- Dossier layout: centered three-column (sidebar + content + TOC) -->
<div class="dossier-layout">
  <!-- Left: Sidebar (nav tree) -->
  <aside class="dossier-sidebar">
    <!-- 移动端折叠头部（PC 端通过 CSS 隐藏） -->
    <div class="dossier-sidebar-header">
      <h3 class="dossier-project-title">
        <a href="/dossier/<%= page.project_id %>/"><%= page.project.title %></a>
      </h3>
      <span class="dossier-sidebar-arrow">▼</span>
    </div>
    <!-- 侧边栏主体（移动端可折叠，PC 端始终可见） -->
    <div class="dossier-sidebar-body">
      <div class="dossier-sidebar-inner">
        <div class="dossier-project-info">
          <h3 class="dossier-project-title">
            <a href="/dossier/<%= page.project_id %>/"><%= page.project.title %></a>
          </h3>
          <% if (page.project.description) { %>
            <p class="dossier-project-desc"><%= page.project.description %></p>
          <% } %>
        </div>
        <nav class="dossier-nav">
          <!-- 项目首页（index.md）始终置顶 -->
          <ul class="dossier-nav-list dossier-nav-index">
            <li class="dossier-nav-item <%= page.type === 'project_home' ? 'active' : '' %>">
              <a href="/dossier/<%= page.project_id %>/" class="dossier-nav-link <%= page.type === 'project_home' ? 'active' : '' %>">
                <span class="dossier-nav-icon">📖</span> <%= page.project.title || tr('dossier.project_overview') %>
              </a>
            </li>
          </ul>
          <!-- 分隔线 -->
          <hr class="dossier-nav-divider">
          <!-- 其他文档 -->
          <%- partial('_partial/dossier_tree', { nav: page.nav, current: page.path }) %>
        </nav>
      </div>
    </div>
  </aside>

  <!-- Center: Content -->
  <main class="dossier-content">
    <!-- Breadcrumb (inside content area, aligns with content text) -->
    <div class="dossier-bread">
      <a href="/dossier/">Dossier</a>
      &nbsp;&raquo;&nbsp;<a href="/dossier/<%= page.project_id %>/"><%= page.project.title %></a>
      <% if (!isHome && page.title) { %>
        &nbsp;&raquo;&nbsp;<%= page.title %>
      <% } %>
    </div>

    <!-- 移动端文章导航下拉菜单（仅 ≤768px 可见, 非首页） -->
    <% if (!isHome) { %>
    <%
      function flatDossierNav(items, curPath) {
        var h = '';
        for (var i = 0; i < items.length; i++) {
          var item = items[i];
          if (item.type === 'section') {
            if (item.children && item.children.length > 0) {
              h += flatDossierNav(item.children, curPath);
            }
          } else {
            var active = (item.url === '/' + curPath) ? ' active' : '';
            h += '<a href="' + item.url + '" class="dossier-mobile-nav-item' + active + '">' + item.title + '</a>';
          }
        }
        return h;
      }
      var navListHtml = flatDossierNav(page.nav, page.path);
    %>
    <div class="dossier-mobile-nav">
      <div class="dossier-mobile-nav-current">
        <div class="dossier-mobile-nav-info">
          <span class="dossier-mobile-nav-project"><%= page.project.title %></span>
          <span class="dossier-mobile-nav-title"><%= page.title %></span>
        </div>
        <span class="dossier-mobile-nav-arrow">▼</span>
      </div>
      <div class="dossier-mobile-nav-list">
        <%- navListHtml %>
      </div>
    </div>
    <% } %>

    <% if (isHome) { %>
      <h1 class="post-title"><%= page.project.title %></h1>
      <% if (page.project.description) { %>
        <p class="dossier-project-desc"><%= page.project.description %></p>
      <% } %>
      <div class="post-body">
        <%- bodyHtml %>
      </div>
      <% var dcard = (theme.dossier && theme.dossier.card) || {};
         if (page.project.firstArticleUrl && dcard.show_start_button !== false) { %>
      <div class="dossier-home-footer">
        <a href="<%= page.project.firstArticleUrl %>" class="dossier-start-reading<%= dcard.start_button_style === 'minimal' ? ' dossier-start-minimal' : (dcard.start_button_style === 'outline' ? ' dossier-start-outline' : '') %>">
          <span class="start-label"><%= tr_cfg(dcard.start_button_text, 'dossier.start_reading') %></span>
          <span class="start-arrow">→</span>
        </a>
      </div>
      <% } %>
    <% } else { %>
      <h1 class="post-title"><%= page.title %></h1>
      <% if (page.updated) { %>
        <div class="dossier-page-meta">
          <span class="dossier-page-updated"><%= tr('dossier.updated_at', page.updated) %></span>
        </div>
      <% } %>
      <div class="post-body">
        <%- bodyHtml %>
      </div>

      <!-- Tags -->
      <% if (page.tags && page.tags.length > 0) { %>
        <div class="post-meta">
          <% page.tags.forEach(function(t) { %>
            <a href="/dossier/tags/<%= encodeURIComponent(t) %>/">#<%= t %></a>
          <% }); %>
        </div>
      <% } %>
    <% } %>

    <!-- Bottom pagination: prev / next (doc pages only) -->
    <% if (!isHome && theme.dossier.show_pagination !== false) { %>
    <nav class="dossier-pagination">
      <% if (page.prev) { %>
        <a href="<%= page.prev.url %>" class="dossier-prev">
          <span class="nav-label"><%= tr('dossier.prev_doc') %></span>
          <span class="nav-title"><%= page.prev.title %></span>
        </a>
      <% } else { %>
        <span class="dossier-prev disabled">
          <span class="nav-label"><%= tr('dossier.prev_doc') %></span>
          <span class="nav-title"><%= tr('dossier.no_more') %></span>
        </span>
      <% } %>

      <% if (page.next) { %>
        <a href="<%= page.next.url %>" class="dossier-next">
          <span class="nav-label"><%= tr('dossier.next_doc') %></span>
          <span class="nav-title"><%= page.next.title %></span>
        </a>
      <% } else { %>
        <span class="dossier-next disabled">
          <span class="nav-label"><%= tr('dossier.next_doc') %></span>
          <span class="nav-title"><%= tr('dossier.no_more') %></span>
        </span>
      <% } %>
    </nav>
    <% } %>
  </main>

  <!-- Right: TOC -->
  <aside class="dossier-toc" id="dossier-toc"
         data-toc-highlight="<%= (theme.toc || {}).highlight_on_scroll !== false %>"
         data-toc-collapse="<%= (theme.toc || {}).auto_collapse !== false %>">
    <div class="toc-fixed">
      <div class="toc-wrapper<%= (theme.toc.show_tree_line === false) ? ' toc-no-tree-line' : '' %>">
        <div class="toc-title"><%= tr('toc.title') %></div>
        <% if (!isHome && page.toc && page.toc.length > 0) { %>
          <%- render_toc(page.toc) %>
          <div class="toc-footer">
            <button class="toc-back-top" type="button">
              <span class="toc-back-icon">↑</span> <%= tr('common.back_to_top') %>
            </button>
          </div>
        <% } else { %>
          <div class="toc-empty"><%= tr('dossier.empty_toc') %></div>
        <% } %>
      </div>
    </div>
  </aside>
</div>

<style>
/* ============================================
   Dossier Layout — Centered Three-Column
   ============================================ */

/* Main container: centered, flex, fixed column widths */
.dossier-layout {
  display: flex;
  justify-content: center;
  gap: 0;
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 20px;
  position: relative;
}

/* ===== Sidebar (240px fixed) ===== */
.dossier-sidebar {
  flex: 0 0 240px;
  width: 240px;
  position: sticky;
  top: 4rem;
  height: calc(100vh - 6rem);
  overflow-y: auto;
  padding-right: 24px;
  border-right: 1px solid var(--c-border);
  -ms-overflow-style: none;
  scrollbar-width: thin;
}
.dossier-sidebar::-webkit-scrollbar {
  width: 4px;
}
.dossier-sidebar-inner {
  padding-top: 0.5em;
}

/* Project info */
.dossier-project-info {
  margin-bottom: 1.5em;
  padding-bottom: 1em;
  border-bottom: 1px solid var(--c-border);
}
.dossier-project-title {
  font-size: 1rem;
  font-weight: 500;
  margin: 0;
}
.dossier-project-title a {
  color: var(--c-text);
  text-decoration: none;
}
.dossier-project-title a:hover {
  color: var(--c-accent);
}
.dossier-project-desc {
  font-size: 0.8rem;
  color: var(--c-text-light);
  margin-top: 0.3em;
  line-height: 1.5;
}

/* Breadcrumb (inside content area) */
.dossier-bread {
  font-size: 0.85rem;
  color: var(--c-text-light);
  margin-bottom: 1.5em;
}
.dossier-bread a {
  color: var(--c-text-light);
}
.dossier-bread a:hover {
  color: var(--c-accent);
}

/* ===== Content (720px fixed) ===== */
.dossier-content {
  flex: 0 0 720px;
  width: 720px;
  padding: 0 48px;
  min-height: 60vh;
}

/* Page meta */
.dossier-page-meta {
  margin-bottom: 1em;
}
.dossier-page-updated {
  font-size: 0.8rem;
  color: var(--c-text-light);
}

/* ===== TOC ===== */
.dossier-toc {
  /* flex 占位容器，保持三栏布局稳定 */
  flex: 0 0 200px;
  width: 200px;
  padding-left: 24px;
  border-left: 1px solid var(--c-border);
  /* 覆盖 style.css 中的 mask-image，避免裁剪 position:fixed 的子元素 */
  mask-image: none !important;
  -webkit-mask-image: none !important;
  visibility: hidden;
}
.dossier-toc .toc-fixed {
  /* position: fixed — 与 blog TOC 一致，始终可见 */
  position: fixed;
  top: 4rem;
  width: 200px;
  max-height: calc(100vh - 6rem);
  overflow-y: auto;
  padding-top: 2rem;
  overflow-wrap: break-word;
  word-break: break-word;
  visibility: visible;
  scrollbar-width: none;
  -ms-overflow-style: none;
  /* 右边缘位置与 blog TOC 公式一致 */
  right: calc(50vw - 600px);
  z-index: 10;
}
.dossier-toc .toc-fixed::-webkit-scrollbar {
  display: none;
}

/* ===== Nav Tree (sidebar) ===== */
.dossier-nav-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.dossier-nav-item {
  margin-bottom: 0.15em;
}
.dossier-nav-item.active {
  font-weight: 500;
}
.dossier-nav-link {
  display: block;
  padding: 0.2em 0;
  font-size: 0.88rem;
  color: var(--c-text-light);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-decoration: none;
  border-left: 2px solid transparent;
  padding-left: 8px;
  transition: color 0.15s, border-color 0.15s;
}
.dossier-nav-link:hover {
  color: var(--c-accent);
}
.dossier-nav-link.active {
  color: var(--c-accent);
  border-left-color: var(--c-accent);
  font-weight: 500;
}
.dossier-nav-icon {
  margin-right: 4px;
}
.dossier-nav-divider {
  border: none;
  border-top: 0.5px solid var(--c-hr-weak);
  margin: 0.6em 0;
  position: relative;
}
.dossier-nav-divider::after {
  content: '';
  display: block;
  border-top: 0.5px solid var(--c-hr-weak);
  margin-top: 3px;
}
.dossier-nav-index {
  margin-bottom: 0;
}

.dossier-tree {
  list-style: none;
  padding: 0;
  margin: 0;
}
.dossier-tree li {
  margin-bottom: 0.15em;
}
.dossier-tree a {
  display: block;
  padding: 0.2em 0;
  font-size: 0.88rem;
  color: var(--c-text-light);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-decoration: none;
  border-left: 2px solid transparent;
  padding-left: 8px;
  transition: color 0.15s, border-color 0.15s;
}
.dossier-tree a:hover {
  color: var(--c-accent);
}
.dossier-tree a.active {
  color: var(--c-accent);
  border-left-color: var(--c-accent);
  font-weight: 500;
}
.dossier-tree .tree-parent > a {
  font-weight: 600;
  font-size: 0.8rem;
  color: var(--c-text-muted);
  margin-top: 0.6em;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-left: none;
  padding-left: 0;
}
.dossier-tree .tree-children {
  padding-left: 12px;
}

/* ===== Bottom Pagination ===== */
.dossier-pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 48px;
  padding-top: 24px;
  border-top: 1px solid var(--c-border);
  gap: 12px;
}
.dossier-prev,
.dossier-next {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: var(--c-text);
  padding: 8px 12px;
  border-radius: 4px;
  transition: background 0.2s;
  min-width: 0;
  flex: 1;
}
.dossier-prev:hover,
.dossier-next:hover {
  background: var(--c-hover-bg);
}
.dossier-prev .nav-label,
.dossier-next .nav-label {
  font-size: 0.78rem;
  color: var(--c-text-light);
}
.dossier-prev .nav-title,
.dossier-next .nav-title {
  font-size: 0.92rem;
  font-weight: 500;
  margin-top: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.dossier-prev.disabled,
.dossier-next.disabled {
  opacity: 0.35;
  cursor: not-allowed;
  pointer-events: none;
}

/* ===== Mobile sidebar: header hidden on PC ===== */
@media (min-width: 769px) {
  .dossier-sidebar-header {
    display: none !important;
  }
  .dossier-mobile-nav {
    display: none !important;
  }
}

/* ===== Home page start reading button =====
   .dossier-start-reading 的全部样式在 source/css/style.css 里（唯一来源）。
   这里只保留外层的间距，避免两处规则打架：
   模板内联 <style> 排在 head 里的样式表之后，同优先级下会胜出，
   之前正是这段旧规则把按钮涂成了「青底青字」，夜间模式下几乎看不清。 */
.dossier-home-footer {
  margin-top: 36px;
  padding-top: 0;
  border-top: none;
}

/* ===== Responsive ===== */

/* Medium screens (1024px – 1280px): narrower columns */
@media (max-width: 1280px) {
  .dossier-content {
    flex: 0 0 600px;
    width: 600px;
    padding: 0 32px;
  }
  .dossier-sidebar {
    flex: 0 0 200px;
    width: 200px;
    padding-right: 16px;
  }
  .dossier-toc {
    flex: 0 0 180px;
    width: 180px;
    padding-left: 16px;
    overflow-wrap: break-word;
    word-break: break-word;
  }
}

/* Tablet (769px – 1023px): single column, sidebar on top
   ---------------------------------------------------------------------------
   这里原来写的是 max-width: 1024px，把 .dossier-toc 一起隐掉了。
   但底部面板 / 悬浮球此前只在 ≤768px 出现 —— 于是 769~1023px 这段宽度里
   档案页没有任何目录入口（侧栏被这段藏了，面板还没到出现的宽度）。
   现在统一到 1023px：.dossier-toc 在 >1023px 可见，≤1023px 交给底部面板。 */
@media (max-width: 1023px) {
  .dossier-layout {
    flex-direction: column;
    padding: 0 16px;
    max-width: 100%;
  }
  .dossier-sidebar {
    flex: none;
    width: 100%;
    position: relative;
    top: 0;
    height: auto;
    max-height: 320px;
    border-right: none;
    border-bottom: 1px solid var(--c-border);
    padding-right: 0;
    padding-bottom: 16px;
    margin-bottom: 16px;
    overflow-y: auto;
  }
  .dossier-sidebar-inner {
    padding-top: 0;
  }
  .dossier-project-info {
    margin-bottom: 0.8em;
    padding-bottom: 0.8em;
  }
  .dossier-content {
    flex: none;
    width: 100%;
    padding: 0;
    min-height: auto;
  }
  .dossier-toc {
    display: none;
  }
}

/* Mobile (<768px): tighter spacing, stacked pagination */
@media (max-width: 768px) {
  .dossier-layout {
    padding: 0 12px;
    /* 单列后必须允许收缩：上面桌面的 flex 基线是 0 0 720px 固定宽，
       不在这里复位的话，窄屏正文仍是 720px 宽，被容器裁掉右半部分。 */
    max-width: 100%;
    width: 100%;
  }
  .dossier-sidebar {
    max-height: 240px;
    flex: none;
    width: 100%;
  }
  .dossier-content {
    padding: 0;
    flex: none;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }
  /* 长 URL / 长代码行在窄屏不该撑破布局 */
  .dossier-content .post-body,
  .dossier-content .post-body p,
  .dossier-content .post-body li {
    overflow-wrap: break-word;
    word-break: break-word;
  }
  .dossier-content .post-body table,
  .dossier-content .post-body pre {
    display: block;
    width: 100%;
    overflow-x: auto;
  }
  .dossier-pagination {
    flex-direction: column;
    gap: 8px;
    align-items: stretch;
  }
  .dossier-prev,
  .dossier-next {
    align-items: center;
    padding: 6px 12px;
  }
}
</style>

<script>
(function() {
  // --- Sidebar: highlight current article + auto-scroll ---
  const sidebar = document.querySelector('.dossier-sidebar');
  const currentPath = window.location.pathname;
  const navLinks = document.querySelectorAll('.dossier-nav-link');

  navLinks.forEach(function(link) {
    var href = link.getAttribute('href');
    if (!href) return;
    // Normalize trailing slash for comparison
    if (href === currentPath || href.replace(/\/$/, '') === currentPath.replace(/\/$/, '')) {
      link.classList.add('active');
      // Expand parent tree sections
      var parent = link.closest('li');
      while (parent) {
        parent.classList.add('expanded');
        parent = parent.parentElement ? parent.parentElement.closest('li') : null;
      }
    }
  });

  // Scroll sidebar to show active link
  var activeLink = document.querySelector('.dossier-nav-link.active');
  if (activeLink && sidebar) {
    var linkTop = activeLink.offsetTop;
    var sidebarHeight = sidebar.clientHeight;
    if (linkTop > sidebarHeight) {
      sidebar.scrollTop = linkTop - sidebarHeight / 2;
    }
  }

  /* TOC 的高亮 / 折叠 / 平滑跳转统一由 /js/toc.js 处理 —— 这里不再重复实现。
     以前这份是 toc.ejs 里那段逻辑的副本，已经漂移出真实差异：
     highlight_on_scroll:false + auto_collapse:true 时整块目录会被藏掉。 */

})();
</script>
